@page
@model LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<h1>@ViewData["Title"]</h1>

<div class="col-sm-8 col-md-5">
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary">Zaloguj się</button>
    </form>
    <ul class="list-unstyled mt-3">
        <li><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Załóż konto</a></li>
        <li><a asp-page="./ForgotPassword">Nie pamiętam hasła</a></li>
        <li><a asp-page="./ResendEmailConfirmation">Wyślij ponownie link potwierdzający</a></li>
    </ul>
    @if (Model.ExternalLogins.Any())
    {
        <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @foreach (var provider in Model.ExternalLogins)
            {
                <button type="submit" class="btn btn-outline-primary" name="provider" value="@provider.Name">@provider.DisplayName</button>
            }
        </form>
    }
</div>

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
