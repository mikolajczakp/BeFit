@model ExerciseType

@{
    ViewData["Title"] = "Usuń typ ćwiczenia";
}

<h1>@ViewData["Title"]</h1>

<p>Czy na pewno chcesz usunąć typ ćwiczenia <strong>@Html.DisplayFor(model => model.Name)</strong>?</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Usuń</button>
    <a asp-action="Index" class="btn btn-link">Anuluj</a>
</form>
