@model IEnumerable<ExerciseType>
@using BeFit.Security
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

@{
    ViewData["Title"] = "Typy ćwiczeń";
    var isAdministrator = User.IsInRole(Administrator.Role);
}

<h1>@ViewData["Title"]</h1>

@if (isAdministrator)
{
    <p><a asp-action="Create" class="btn btn-primary">Dodaj typ ćwiczenia</a></p>
}

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(exerciseType => exerciseType.Name)</th>
                @if (isAdministrator)
                {
                    <th scope="col">Akcje</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var exerciseType in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(_ => exerciseType.Name)</td>
                    @if (isAdministrator)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@exerciseType.Id">Edytuj</a>
                            <a asp-action="Delete" asp-route-id="@exerciseType.Id" class="ms-2 text-danger">Usuń</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nie dodano jeszcze żadnych typów ćwiczeń.</p>

    @if (HostEnvironment.IsDevelopment() && !isAdministrator)
    {
        <h2 class="h5">Pierwsze uruchomienie</h2>
        <ol>
            <li>Zarejestruj konto, np. <code>admin@befit.test</code>, i kliknij link potwierdzający.</li>
            <li>Otwórz terminal w folderze z plikiem <code>BeFit.slnx</code> i uruchom polecenie z adresem tego konta.</li>
            <li>Zaloguj się ponownie. W katalogu pojawi się przycisk <strong>Dodaj typ ćwiczenia</strong>.</li>
        </ol>
        <pre><code>dotnet run --project BeFit --no-build -- @Administrator.GrantCommand admin@@befit.test</code></pre>
    }
}
