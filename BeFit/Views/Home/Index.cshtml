@{
    ViewData["Title"] = "Start";
}

@if (ViewData["AdministratorSetupEmail"] is string email)
{
    <partial name="_AdministratorSetup" model="email" />
}

<div class="text-center">
    <h1 class="display-4">BeFit</h1>
    <p>Zapisuj treningi, dodawaj wykonane ćwiczenia i sprawdzaj statystyki z ostatnich czterech tygodni.</p>
    <a class="btn btn-primary" asp-controller="WorkoutSessions" asp-action="Index">Przejdź do moich treningów</a>
</div>
