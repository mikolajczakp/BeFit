@model ErrorViewModel
@{
    ViewData["Title"] = "Błąd";
}

<h1 class="text-danger">Wystąpił błąd</h1>
<p>Nie udało się wykonać tej operacji. Spróbuj ponownie.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identyfikator zgłoszenia</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index">Wróć na stronę główną</a>
