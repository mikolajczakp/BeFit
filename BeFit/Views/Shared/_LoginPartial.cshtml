@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    var page = ViewContext.RouteData.Values["page"] as string;
    var accountSection = page?.StartsWith("/Account/Manage/", StringComparison.OrdinalIgnoreCase) == true;
    var registrationSection = page is "/Account/Register" or "/Account/RegisterConfirmation" or "/Account/ConfirmEmail";
}

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Ustawienia konta"
           aria-current="@(accountSection ? (page == "/Account/Manage/Index" ? "page" : "location") : null)">@User.Identity?.Name</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-dark">Wyloguj się</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register"
           aria-current="@(registrationSection ? (page == "/Account/Register" ? "page" : "location") : null)">Zarejestruj się</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login"
           aria-current="@(page == "/Account/Login" ? "page" : null)">Zaloguj się</a>
    </li>
}
</ul>
