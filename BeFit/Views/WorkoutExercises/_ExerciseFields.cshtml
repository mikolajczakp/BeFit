@model WorkoutExercise

@{
    var exerciseTypes = (SelectList)ViewData["ExerciseTypes"]!;
}

<div class="mb-3">
    <label asp-for="ExerciseTypeId" class="form-label"></label>
    <select asp-for="ExerciseTypeId" asp-items="exerciseTypes" class="form-select">
        <option value="">Wybierz typ ćwiczenia</option>
    </select>
    <span asp-validation-for="ExerciseTypeId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="WeightKg" class="form-label"></label>
    <input asp-for="WeightKg" type="number" step="any" class="form-control" aria-describedby="weight-help" />
    <div id="weight-help" class="form-text">Wpisz 0, jeśli ćwiczysz bez dodatkowego ciężaru.</div>
    <span asp-validation-for="WeightKg" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Sets" class="form-label"></label>
    <input asp-for="Sets" class="form-control" />
    <span asp-validation-for="Sets" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="RepetitionsPerSet" class="form-label"></label>
    <input asp-for="RepetitionsPerSet" class="form-control" />
    <span asp-validation-for="RepetitionsPerSet" class="text-danger"></span>
</div>
